<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8"/><meta content="width=device-width,initial-scale=1" name="viewport"/><title>VaYa | Centro de entregas</title><style>
:root{font-family:system-ui,-apple-system,Segoe UI,sans-serif;background:#101114;color:#f8f8f8}*{box-sizing:border-box}body{margin:0}button,input,select,textarea{font:inherit}button{cursor:pointer}header{background:#191a1e;border-bottom:1px solid #34363d;padding:18px max(20px,calc((100vw - 1200px)/2));display:flex;align-items:center;justify-content:space-between;gap:12px}.logo{font-weight:950;font-style:italic;font-size:35px;letter-spacing:-2px}.orange{color:#ff781c}.sub,.muted{color:#b3b4bd;font-size:13px}.pill{border:1px solid #69442b;color:#ffb17d;background:#33251d;padding:5px 11px;border-radius:30px;font-size:12px}main{max-width:1200px;margin:auto;padding:25px 18px}h1{font-size:clamp(25px,4vw,38px);margin:0 0 9px}h2{font-size:20px;margin:0 0 15px}h3{margin:10px 0;font-size:16px}p{line-height:1.5;color:#bfc0c7}.hero{padding:26px;background:linear-gradient(110deg,#382519,#1b1c20 70%);border:1px solid #644029;border-radius:18px}.tabs{display:flex;gap:8px;overflow:auto;padding:20px 0 8px}.tab{background:#27292e;color:#e9e9ed;border:1px solid #41434a;border-radius:10px;padding:11px 14px;white-space:nowrap}.tab.active{background:#ff781c;color:#171717;border-color:#ff781c;font-weight:750}.page{display:none}.page.active{display:block}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:16px 0}.metric,.panel{background:#1b1d22;border:1px solid #383a41;border-radius:15px;padding:19px}.metric strong{font-size:27px;display:block;margin:7px 0}.cols{display:grid;grid-template-columns:1fr 1.15fr;gap:15px}.field{display:flex;flex-direction:column;gap:5px;margin-bottom:13px}label{font-size:13px;color:#ddd}input,select,textarea{background:#101115;color:#fff;border:1px solid #52545b;border-radius:9px;padding:11px;width:100%;outline:none}input:focus,select:focus{border-color:#ff781c}.btn{background:#ff781c;border:0;color:#111;padding:11px 15px;border-radius:9px;font-weight:750}.btn.alt{background:#393b42;color:#fff}.btn.outline{background:transparent;color:#ffad79;border:1px solid #a55b2c}.btn:disabled{opacity:.5;cursor:not-allowed}.actions{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.item{background:#25272d;border:1px solid #3c3e45;border-radius:12px;padding:13px;margin:9px 0}.itemtop{display:flex;justify-content:space-between;gap:10px;align-items:start}.item small{display:block;color:#bdbfc6;margin:4px 0;overflow-wrap:anywhere}.status{display:inline-block;border-radius:20px;padding:4px 9px;background:#423124;color:#ffc090;font-size:12px}.empty{border:1px dashed #555;padding:22px;text-align:center;color:#bbb;border-radius:12px}.notice{font-size:12px;color:#eeb58d}#map{height:430px;border-radius:12px;background:#303238;margin:15px 0}.route-step{border-left:3px solid #ff781c;padding:8px 13px;margin:10px 0;background:#25272c;border-radius:0 9px 9px 0}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.toast{position:fixed;right:15px;bottom:15px;background:#ff781c;color:#111;padding:12px 18px;border-radius:12px;box-shadow:0 5px 25px #0008;z-index:9999;max-width:350px;display:none}footer{text-align:center;color:#92939a;padding:30px}@media(max-width:800px){.grid{grid-template-columns:repeat(2,1fr)}.cols,.two{grid-template-columns:1fr}#map{height:340px}header{padding:15px 18px}}@media(max-width:450px){.grid{grid-template-columns:1fr 1fr}.metric{padding:12px}.metric strong{font-size:22px}.itemtop{flex-direction:column}}

.auth-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:15px}.auth-hidden{display:none!important}.plan-card{border:1px solid #45464d;border-radius:13px;padding:18px;background:#24252b}.plan-card.selected{border-color:#ff781c}.plan-price{font-size:28px;font-weight:800;color:#ffad79}.account-bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.auth-message{font-size:13px;color:#ffbd8c;min-height:20px}.plan-card button{margin-top:10px}

:root{background:#0b1321;color:#f7f9ff;--orange:#ff982e}body{background:radial-gradient(ellipse at 20% -5%,#283c58 0,transparent 45%),#0b1321}header{background:#142236;border-bottom-color:#344b65;box-shadow:0 6px 30px #0003}.hero{background:linear-gradient(115deg,#54301d 0%,#233e60 58%,#15273d);border-color:#925b35;box-shadow:0 12px 40px #0003}.orange{color:#ffa03a}.metric,.panel{background:#17263a;border-color:#324961;box-shadow:0 8px 26px #0002}.metric{background:linear-gradient(140deg,#213651,#17283e)}.metric strong{color:#ffb264}.tab{background:#22344b;border-color:#3c526a}.tab.active,.btn{background:#ff9b32;border-color:#ff9b32;color:#101c2d}.btn.alt{background:#354a63}.btn.outline{color:#ffbd86;border-color:#ad754c}.item{background:#22344b;border-color:#3e5772}.status{background:#4c3828;color:#ffd0a6}.route-step{background:#22364e;border-color:#ff9b32}input,select,textarea{background:#101d30;border-color:#4a6380}input:focus,select:focus,textarea:focus{border-color:#ff9b32}.plan-card{background:#21334a;border-color:#40566f}.pill{background:#3b322d}.notice{color:#ffd0aa}.tabs{scrollbar-width:thin}.modal-overlay{position:fixed;inset:0;background:#06101cc9;z-index:20000;display:flex;align-items:center;justify-content:center;padding:18px}.modal-overlay[hidden]{display:none}.modal-dialog{background:#1e3149;border:1px solid #58718c;border-radius:20px;max-width:420px;width:100%;padding:26px;box-shadow:0 25px 90px #0009}.modal-dialog .actions{justify-content:flex-end}.status.ok{background:#204e40;color:#b4f9d9}.status.danger{background:#64323b;color:#ffb4bc}.status.warn{background:#624923;color:#ffe1a3}.row-line{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.mini{font-size:12px;color:#b9cde2}.history-card{border:1px solid #405b77;border-radius:13px;margin:12px 0;padding:14px;background:#203249}.history-card summary{cursor:pointer;font-weight:750}.history-card .item{margin-top:12px}.muted{color:#c1d0df}.premium-locked{border:1px solid #ad7645;background:#3a2c26;padding:14px;border-radius:12px}.tiny-action{padding:6px 9px;font-size:12px}
</style></head><body><header><div><div class="logo">Va<span class="orange">Ya</span></div><div class="sub">Visión, Agilidad y Optimización de Entregas</div></div><div class="account-bar"><span class="pill" id="accountStatus">Sin iniciar sesión</span><button class="btn alt auth-hidden" id="logoutButton" onclick="vayaLogout()">Cerrar sesión</button></div></header><main><section class="panel" id="authPanel" style="margin-bottom:18px"><h2>🔐 Tu cuenta VaYa</h2><p>Regístrate o inicia sesión para identificar tu cuenta. Confirma tu correo electrónico después de registrarte.</p><div class="auth-grid"><form id="signupForm"><h3>Crear cuenta</h3><div class="field"><label for="signupEmail">Correo electrónico</label><input autocomplete="email" id="signupEmail" required="" type="email"/></div><div class="field"><label for="signupPassword">Contraseña (mínimo 8 caracteres)</label><input autocomplete="new-password" id="signupPassword" minlength="8" required="" type="password"/></div><button class="btn" type="submit">Registrarme</button></form><form id="loginForm"><h3>Iniciar sesión</h3><div class="field"><label for="loginEmail">Correo electrónico</label><input autocomplete="email" id="loginEmail" required="" type="email"/></div><div class="field"><label for="loginPassword">Contraseña</label><input autocomplete="current-password" id="loginPassword" required="" type="password"/></div><button class="btn" type="submit">Entrar</button></form></div><p class="auth-message" id="authMessage" role="status"></p><p class="notice">La cuenta utiliza Supabase Auth. Los pedidos y rutas todavía se almacenan únicamente en este navegador; iniciar sesión no los sincroniza ni los protege en una base de datos.</p></section><section class="hero"><h1>Entregas inteligentes. <span class="orange">Menos vueltas.</span></h1><p>Tu asistente de reparto independiente: organiza pedidos, prioriza entregas y conoce tus ganancias.</p><div class="actions"><button class="btn" onclick="go('pedidos')">+ Registrar pedido</button><button class="btn alt" onclick="demo()">Cargar demostración</button></div></section><nav aria-label="Secciones" class="tabs"><button class="tab active" data-tab="inicio" onclick="go('inicio')">Inicio</button><button class="tab" data-tab="pedidos" onclick="go('pedidos')">Pedidos</button><button class="tab" data-tab="rutas" onclick="go('rutas')">Mapa y rutas</button><button class="tab" data-tab="repartidores" onclick="go('repartidores')">Mi jornada</button><button class="tab" data-tab="estadisticas" onclick="go('estadisticas')">Mi rendimiento</button><button class="tab" data-tab="historial" onclick="go('historial')">Historial</button><button class="tab" data-tab="avisos" onclick="go('avisos')">Avisos</button><button class="tab" data-tab="ganancias" onclick="go('ganancias')">Mis ganancias</button><button class="tab" data-tab="premium" onclick="go('premium')">Herramientas Premium</button><button class="tab" data-tab="planes" onclick="go('planes')">Mi plan</button></nav>
<section class="page active" id="inicio"><div class="grid"><div class="metric"><span class="muted">Pedidos</span><strong id="mTotal">0</strong><span class="muted">Registrados</span></div><div class="metric"><span class="muted">Entregados</span><strong id="mDone">0</strong><span class="muted">Confirmados</span></div><div class="metric"><span class="muted">Pendientes</span><strong id="mPending">0</strong><span class="muted">Por entregar</span></div><div class="metric"><span class="muted">En camino</span><strong id="mTransit">0</strong><span class="muted">En reparto</span></div></div><div class="panel"><h2>Tu centro logístico</h2><p>Comienza agregando pedidos y repartidores. Después, en «Mapa y rutas», busca las direcciones y pulsa «Optimizar ruta real» para calcular una secuencia basada en distancias por carretera.</p><p class="notice">Los datos se guardan solo en este navegador. No hay autenticación, servidor ni sincronización entre dispositivos. Usa información ficticia durante las pruebas.</p></div></section>
<section class="page" id="pedidos"><div class="cols"><div class="panel"><h2>📦 Nuevo pedido</h2><form id="orderForm"><div class="field"><label for="client">Cliente</label><input id="client" maxlength="80" placeholder="Nombre del cliente" required=""/></div><div class="field"><label for="address">Dirección completa</label><input id="address" maxlength="250" placeholder="Calle, número, ciudad, estado" required=""/></div><div class="field"><label for="phone">WhatsApp (opcional, con código de país)</label><input id="phone" inputmode="tel" maxlength="18" placeholder="Ej. 528671234567"/></div><div class="field"><label for="description">Descripción</label><input id="description" maxlength="120" placeholder="Paquete, comida, etc."/></div><div class="two"><div class="field"><label for="priority">Prioridad</label><select id="priority"><option value="normal">Normal</option><option value="alta">Alta</option><option value="urgente">Urgente</option></select></div><div class="field"><label for="deadline">Fecha y hora límite</label><input id="deadline" type="datetime-local"/></div></div><div class="field"><select id="driverSelect" style="display:none"><option value="">Mi reparto</option></select></div><div class="field"><label for="orderFee">Pago por entrega (MXN)</label><input id="orderFee" min="0" step="0.01" type="number" value="0"/></div><button class="btn" type="submit">Guardar pedido</button></form></div><div class="panel"><h2>📋 Gestión de pedidos</h2><div class="field"><label for="filter">Filtrar por estado</label><select id="filter" onchange="render()"><option value="todos">Todos</option><option value="pendiente">Pendientes</option><option value="en camino">En camino</option><option value="entregado">Entregados</option><option value="no entregado">No entregados</option></select></div><div id="orders"></div></div></div></section>
<section class="page" id="rutas"><div class="panel"><h2>🗺️ Mi mapa y rutas inteligentes</h2><div class="two"><div class="field"><label for="origin">Punto de salida</label><input id="origin" placeholder="Calle, número, ciudad, estado"/></div></div><div class="actions"><button class="btn" onclick="optimizeRoute()">⚡ Optimizar ruta real</button><button class="btn alt" onclick="showPins()">Mostrar ubicaciones</button><button class="btn alt" onclick="fitMap()">Centrar mapa</button><button class="btn outline" onclick="openMaps()">Abrir ruta en Google Maps ↗</button><button class="btn alt" onclick="openOrdersInGoogleMaps()">Ver pedidos en Google Maps (sin API) ↗</button></div><div class="item" style="border-color:#995727"><h3>🗝️ Configurar Google Maps</h3><p class="notice">Introduce tu clave de Maps JavaScript API solo en la página publicada de VaYa. Se guarda en este navegador. Antes, restríngela en Google Cloud al dominio de GitHub Pages y a Maps JavaScript API y Geocoding API. No uses claves sin restricciones.</p><div class="two"><div class="field"><label for="googleKey">Clave API de Google Maps</label><input autocomplete="off" id="googleKey" placeholder="Pega aquí tu clave API" type="password"/></div><div class="field"><label for="mapStyle">Estilo del mapa</label><select id="mapStyle"><option value="roadmap">Calles</option><option value="hybrid">Híbrido</option><option value="terrain">Relieve</option></select></div></div><div class="actions"><button class="btn" onclick="saveMapSettings()">Guardar y activar mapa</button><button class="btn alt" onclick="removeMapSettings()">Quitar clave</button><a class="btn outline" href="https://console.cloud.google.com/google/maps-apis/credentials" rel="noopener noreferrer" style="text-decoration:none" target="_blank">Obtener clave ↗</a></div><div aria-live="polite" class="notice" id="mapConfigStatus"></div></div><div aria-label="Mapa de entregas" id="map" role="region"><div style="padding:30px;text-align:center;color:#eee">🗺️ Google Maps aparecerá aquí cuando guardes una clave API válida en la versión publicada de VaYa.</div></div><p aria-live="polite" class="notice" id="mapStatus">El mapa integrado y la búsqueda de direcciones requieren una clave de Google Maps válida y conexión a internet. El cálculo de recorridos utiliza OSRM, un servicio externo independiente (no la Routes API de Google). No incorpora tráfico en vivo ni garantiza la ruta óptima. El botón «Ver pedidos en Google Maps» funciona sin clave API.</p><div class="empty" id="routeList">Aún no hay ruta calculada.</div><div class="actions"><button class="btn alt" onclick="finishRoute()">Guardar distancia de ruta en jornada</button></div></div></section>
<section class="page" id="repartidores"><div class="cols"><div class="panel"><h2>🛵 Mi jornada</h2><p>Inicia tu jornada para agrupar las entregas realizadas y llevar un registro de tu trabajo.</p><div class="item" id="shiftStatus"></div><div class="actions"><button class="btn" onclick="startShift()">Iniciar jornada</button><button class="btn alt" onclick="endShift()">Finalizar jornada</button></div><div class="field"><label for="shiftVehicle">Mi vehículo</label><select id="shiftVehicle"><option>Motocicleta</option><option>Automóvil</option><option>Bicicleta</option><option>Camioneta</option></select></div></div><div class="panel"><h2>Resumen de mi jornada</h2><div id="shiftSummary"></div></div></div></section>
<section class="page" id="estadisticas"><div class="grid"><div class="metric"><span class="muted">Entregas realizadas</span><strong id="statDeliveries">0</strong></div><div class="metric"><span class="muted">Entregas a tiempo</span><strong id="statOnTime">—</strong></div><div class="metric"><span class="muted">Ingresos registrados</span><strong id="statIncome">$0</strong></div><div class="metric"><span class="muted">Distancia última ruta</span><strong id="statKm">—</strong></div></div><div class="panel"><h2>📊 Mi rendimiento</h2><div id="performanceDetails"></div></div></section>
<section class="page" id="historial"><div class="panel"><h2>🕘 Historial por jornadas</h2><p>Consulta únicamente las entregas completadas en cada jornada. Los pedidos pendientes permanecen en tu lista.</p><div id="historyList"></div></div></section>
<section class="page" id="avisos"><div class="panel"><h2>🔔 Notificaciones internas</h2><p>Los avisos aparecen al crear, actualizar o entregar pedidos. Solo se muestran dentro de esta aplicación.</p><div class="actions"><button class="btn alt" onclick="clearNotices()">Limpiar avisos</button></div><div id="noticeList"></div></div></section><section class="page" id="ganancias"><div class="cols"><div class="panel"><h2>💰 Mis ganancias</h2><div class="grid" style="grid-template-columns:repeat(2,minmax(0,1fr))"><div class="metric"><span class="muted">Ingresos registrados</span><strong id="earnTotal">$0</strong></div><div class="metric"><span class="muted">Gastos registrados</span><strong id="expenseTotal">$0</strong></div></div><div class="metric"><span class="muted">Ganancia estimada</span><strong id="netTotal">$0</strong></div><form id="expenseForm"><h3>Agregar gasto</h3><div class="two"><div class="field"><label for="expenseName">Concepto</label><input id="expenseName" placeholder="Gasolina, estacionamiento…" required=""/></div><div class="field"><label for="expenseAmount">Importe MXN</label><input id="expenseAmount" min="0.01" required="" step="0.01" type="number"/></div></div><button class="btn">Guardar gasto</button></form></div><div class="panel"><h2>Movimientos</h2><div id="earningsList"></div></div></div></section>
<section class="page" id="premium"><div class="panel"><h2>👑 Herramientas Premium</h2><p>Funciones para repartidores independientes. Algunas requieren Google Maps, internet y una suscripción Premium verificada para su uso comercial.</p><div class="item" id="premiumAccess"></div><div class="cols"><div><h3>Planificador de jornada</h3><p>Calcula el orden de entregas según distancia, tiempo de carretera, urgencia y hora límite.</p><button class="btn" onclick="go('rutas')">Abrir mapa y planificar</button><h3>Registro rápido desde un mensaje</h3><textarea id="quickText" placeholder="Pega un mensaje con nombre, dirección y horario. Revisa los datos antes de guardar." rows="5"></textarea><div class="actions"><button class="btn alt" onclick="parseQuickOrder()">Preparar pedido</button></div><div class="notice" id="quickPreview"></div></div><div><h3>Pedidos recurrentes</h3><p>Programa un recordatorio de entrega que se repetirá cada semana. Se crearán pedidos pendientes cuando abras VaYa el día correspondiente.</p><form id="repeatForm"><div class="field"><label for="repeatClient">Nombre o referencia</label><input id="repeatClient" required=""/></div><div class="field"><label for="repeatAddress">Dirección</label><input id="repeatAddress" required=""/></div><div class="field"><label for="repeatDay">Día de la semana</label><select id="repeatDay"><option value="1">Lunes</option><option value="2">Martes</option><option value="3">Miércoles</option><option value="4">Jueves</option><option value="5">Viernes</option><option value="6">Sábado</option><option value="0">Domingo</option></select></div><div class="field"><label for="repeatTime">Hora límite</label><input id="repeatTime" type="time"/></div><button class="btn">Crear pedido recurrente</button></form><div id="repeatList"></div></div></div><div class="panel" style="margin-top:16px"><h3>📍 Análisis de zonas</h3><div id="zoneAnalysis"></div></div></div></section>
<section class="page" id="planes"><div class="panel"><h2>💳 Mi plan</h2><p>El acceso de pago requiere una suscripción verificada por Supabase y Stripe. Puedes explorar la comparación sin pagar.</p><div id="planDetails"></div></div></section>
<section class="panel" id="membershipPanel" style="margin-top:18px"><h2>💳 Planes VaYa</h2><div class="auth-grid"><div class="plan-card" id="plan-free"><h3>Gratis</h3><div class="plan-price">$0 MXN</div><p>Hasta 10 pedidos por día, mapa, jornada, historial e ingresos.</p><button class="btn alt" onclick="selectVayaPlan('free')">Conocer Gratis</button></div><div class="plan-card" id="plan-basic"><h3>VaYa Básica</h3><div class="plan-price">$80 MXN/mes</div><p>Pedidos sin límite comercial, historial y rendimiento semanal.</p><button class="btn" onclick="selectVayaPlan('basic')">Conocer Básica</button></div><div class="plan-card" id="plan-premium"><h3>VaYa Premium</h3><div class="plan-price">$180 MXN/mes</div><p>Rutas inteligentes, alertas, finanzas, recurrencias y análisis de zonas.</p><button class="btn" onclick="selectVayaPlan('premium')">Conocer Premium</button></div></div><p class="auth-message" id="planMessage" role="status">Plan Gratis predeterminado. Los planes de pago no se activan seleccionando una tarjeta.</p><p class="notice">Los pagos y permisos Premium deben verificarse en el servidor. Esta versión no realiza cobros ni concede acceso Premium por seleccionar un plan.</p></section></main><footer>VaYa · Proyecto integrador · Logística de última milla</footer><div class="toast" id="toast" role="status"></div><script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script><script>
'use strict';const MAP_KEY_STORAGE='vaya-google-maps-public-key',MAP_STYLE_STORAGE='vaya-google-map-style';const $=id=>document.getElementById(id),KEY='vaya-v2';let state={orders:[],drivers:[],history:[],notices:[],lastRoute:null};try{const saved=JSON.parse(localStorage.getItem(KEY));if(saved&&typeof saved==='object')state={...state,...saved}}catch{};if(!Array.isArray(state.orders))state.orders=[];if(!Array.isArray(state.drivers))state.drivers=[];if(!Array.isArray(state.history))state.history=[];if(!Array.isArray(state.notices))state.notices=[];const old=localStorage.getItem('vaya-orders-v1');if(!state.orders.length&&old){try{const a=JSON.parse(old);if(Array.isArray(a))state.orders=a.map(o=>({id:o.id||uid(),client:o.client,address:o.address,description:o.ref||'',priority:o.priority||'normal',deadline:o.time||'',phone:'',driver:'',status:o.done?'entregado':'pendiente',proof:''}))}catch{}}const uid=()=>typeof crypto!=='undefined'&&crypto.randomUUID?crypto.randomUUID():String(Date.now())+Math.random().toString(36).slice(2);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));let map=null,markers=[],line=null,bounds=null,coordsCache=new Map(),busy=false;function persist(){try{localStorage.setItem(KEY,JSON.stringify(state))}catch{toast('No se pudieron guardar los datos en este navegador')}render()}function toast(msg){const x=$('toast');x.textContent=msg;x.style.display='block';clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>x.style.display='none',3500)}function notify(msg){state.notices.unshift({id:uid(),at:new Date().toLocaleString('es-MX'),msg});state.notices=state.notices.slice(0,100)}function go(id){document.querySelectorAll('.page').forEach(x=>x.classList.toggle('active',x.id===id));document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x.dataset.tab===id));if(id==='rutas')setTimeout(()=>{initMap();fitMap()},80);window.scrollTo({top:220,behavior:'smooth'})}function render(){const o=state.orders;$('mTotal').textContent=o.length;$('mDone').textContent=o.filter(x=>x.status==='entregado').length;$('mPending').textContent=o.filter(x=>x.status==='pendiente').length;$('mTransit').textContent=o.filter(x=>x.status==='en camino').length;const current=$('driverSelect').value,routeCurrent=$('routeDriver').value;const opts='<option value="">Sin asignar / Todos</option>'+state.drivers.map(d=>`<option value="${esc(d.id)}">${esc(d.name)}</option>`).join('');$('driverSelect').innerHTML=opts;$('routeDriver').innerHTML=opts;$('driverSelect').value=current;$('routeDriver').value=routeCurrent;const filtered=o.filter(x=>$('filter').value==='todos'||x.status===$('filter').value);$('orders').innerHTML=filtered.length?filtered.map(x=>`<div class="item"><div class="itemtop"><div><b>${esc(x.client)}</b><small>${esc(x.address)}</small><small>${esc(x.description)} · ${esc(state.drivers.find(d=>d.id===x.driver)?.name||'Sin asignar')}</small><span class="status">${esc(x.status)}${x.priority==='alta'?' · Alta prioridad':''}${x.deadline?' · '+esc(x.deadline):''}</span>${x.proof?`<small>Confirmación: ${esc(x.proof)}</small>`:''}</div><div class="actions"><button class="btn alt" onclick="changeStatus('${esc(x.id)}')">Estado</button><button class="btn outline" onclick="deleteOrder('${esc(x.id)}')">Eliminar</button></div></div>${x.phone?`<div class="actions"><button class="btn alt" onclick="whatsapp('${esc(x.id)}')">WhatsApp ↗</button></div>`:''}</div>`).join(''):'<div class="empty">No hay pedidos para mostrar.</div>';$('driverList').innerHTML=state.drivers.length?state.drivers.map(d=>`<div class="item"><b>${esc(d.name)}</b><small>${esc(d.vehicle)} · ${o.filter(x=>x.driver===d.id).length} pedidos asignados</small><button class="btn outline" onclick="deleteDriver('${esc(d.id)}')">Eliminar perfil</button></div>`).join(''):'<div class="empty">Agrega tu primer repartidor.</div>';$('historyList').innerHTML=state.history.length?state.history.map(h=>`<div class="item"><b>${esc(h.at)}</b><small>${esc(h.driver)} · ${h.stops} paradas · ${h.km==null?'Sin distancia vial':h.km.toFixed(1)+' km'} · ${esc(h.origin)}</small></div>`).join(''):'<div class="empty">Todavía no has guardado recorridos.</div>';$('noticeList').innerHTML=state.notices.length?state.notices.map(n=>`<div class="item"><small>${esc(n.at)}</small>${esc(n.msg)}</div>`).join(''):'<div class="empty">Sin notificaciones.</div>';renderRoute();stats()}
$('orderForm').addEventListener('submit',e=>{e.preventDefault();const x={id:uid(),client:$('client').value.trim(),address:$('address').value.trim(),phone:$('phone').value.replace(/\D/g,''),description:$('description').value.trim(),priority:$('priority').value,deadline:$('deadline').value,driver:$('driverSelect').value,status:'pendiente',proof:''};if(!x.client||!x.address)return;state.orders.push(x);state.lastRoute=null;notify('Nuevo pedido registrado para '+x.client);persist();e.target.reset();toast('Pedido guardado')});$('driverForm').addEventListener('submit',e=>{e.preventDefault();const name=$('driverName').value.trim();if(!name)return;state.drivers.push({id:uid(),name,vehicle:$('vehicle').value});notify('Repartidor agregado: '+name);persist();e.target.reset()});function deleteOrder(id){if(!confirm('¿Eliminar este pedido?'))return;state.orders=state.orders.filter(x=>x.id!==id);state.lastRoute=null;notify('Pedido eliminado');persist()}function deleteDriver(id){if(!confirm('¿Eliminar este perfil? Los pedidos quedarán sin asignar.'))return;state.drivers=state.drivers.filter(x=>x.id!==id);state.orders.forEach(x=>{if(x.driver===id)x.driver=''});state.lastRoute=null;persist()}function changeStatus(id){const x=state.orders.find(o=>o.id===id);if(!x)return;const status=prompt('Nuevo estado: pendiente / en camino / entregado / no entregado',x.status);if(status===null)return;const value=status.trim().toLowerCase();if(!['pendiente','en camino','entregado','no entregado'].includes(value)){toast('Estado no válido');return}if(value==='entregado'){const proof=prompt('Confirmación de entrega (nombre de quien recibe o código; no incluyas datos sensibles):',x.proof||'');if(proof===null)return;if(!proof.trim()){toast('La entrega necesita confirmación');return}x.proof=proof.trim().slice(0,120)}else if(value!=='entregado')x.proof='';x.status=value;state.lastRoute=null;notify('Pedido de '+x.client+': '+value);persist()}function whatsapp(id){const x=state.orders.find(o=>o.id===id);if(!x?.phone)return;const msg='Hola, te contactamos de VaYa sobre tu entrega. ¿Podrías confirmar la dirección?';window.open('https://wa.me/'+encodeURIComponent(x.phone)+'?text='+encodeURIComponent(msg),'_blank','noopener,noreferrer')}function clearNotices(){state.notices=[];persist()}
let googleLoading=null,activeGoogleKey='';
function getMapKey(){return (localStorage.getItem(MAP_KEY_STORAGE)||'').trim()}
function setMapStatus(t){$('mapConfigStatus').textContent=t}
 function explainMapError(e){const m=String(e?.message||e||'Error desconocido');if(/RefererNotAllowedMapError|referer|referrer/i.test(m))return 'La clave no autoriza esta dirección web. Revisa la URL permitida en Google Cloud y abre la versión publicada en GitHub Pages.';if(/BillingNotEnabled|billing/i.test(m))return 'Google Maps requiere que la facturación esté habilitada en el proyecto de Google Cloud.';if(/ApiNotActivated|ApiTargetBlocked|REQUEST_DENIED|Geocoding/i.test(m))return 'Comprueba que Maps JavaScript API y Geocoding API estén habilitadas y autorizadas para esta clave. Detalle: '+m;if(/InvalidKey|ExpiredKey|MissingKey/i.test(m))return 'La clave API no es válida. Revisa la clave configurada en Google Cloud.';return m}
function saveMapSettings(){const k=$('googleKey').value.trim();if(!k)return setMapStatus('Introduce una clave API de Google Maps.');localStorage.setItem(MAP_KEY_STORAGE,k);localStorage.setItem(MAP_STYLE_STORAGE,$('mapStyle').value);setMapStatus('Configuración guardada. Cargando Google Maps…');if(activeGoogleKey&&activeGoogleKey!==k){setMapStatus('Clave actualizada. Recarga la página para usar la nueva clave.');return}initMap()}
function removeMapSettings(){localStorage.removeItem(MAP_KEY_STORAGE);$('googleKey').value='';setMapStatus('Clave eliminada. Recarga la página para quitar el mapa cargado.')}
function loadGoogle(){const k=getMapKey();if(!k){setMapStatus('Configura tu clave API para activar Google Maps.');return Promise.resolve(false)}if(window.google?.maps){if(activeGoogleKey&&activeGoogleKey!==k)throw Error('Recarga la página después de cambiar la clave');return Promise.resolve(true)}if(googleLoading)return googleLoading;googleLoading=new Promise((resolve,reject)=>{const callback='vayaGoogleReady';const script=document.createElement('script');window[callback]=()=>{activeGoogleKey=k;delete window[callback];resolve(true)};script.onerror=()=>{googleLoading=null;reject(Error('No se pudo cargar Google Maps. Comprueba internet, la clave y las restricciones del dominio.'))};script.src='https://maps.googleapis.com/maps/api/js?key='+encodeURIComponent(k)+'&callback='+callback+'&loading=async';script.async=true;document.head.appendChild(script)});return googleLoading}
async function initMap(){try{if(!await loadGoogle())return false;if(!map)map=new google.maps.Map($('map'),{center:{lat:27.4779,lng:-99.5496},zoom:12,mapTypeId:localStorage.getItem(MAP_STYLE_STORAGE)||'roadmap',streetViewControl:false,fullscreenControl:true});else map.setMapTypeId(localStorage.getItem(MAP_STYLE_STORAGE)||'roadmap');setMapStatus('Google Maps cargado.');return true}catch(e){setMapStatus(explainMapError(e));$('mapStatus').textContent=explainMapError(e);return false}}
function fitMap(){if(!map)return;if(bounds)map.fitBounds(bounds,35);else{map.setCenter({lat:27.4779,lng:-99.5496});map.setZoom(12)}}
function clearMap(){markers.forEach(x=>x.setMap(null));markers=[];if(line)line.setMap(null);line=null;bounds=null}
async function geocode(address){if(coordsCache.has(address))return coordsCache.get(address);if(!await initMap())throw Error('Activa Google Maps antes de buscar direcciones');const geocoder=new google.maps.Geocoder();let results;try{({results}=await geocoder.geocode({address,region:'MX'}))}catch(e){throw Error('Google no pudo localizar: '+address+'. '+explainMapError(e))}if(!results.length)throw Error('No se encontró: '+address);const loc=results[0].geometry.location,point=[loc.lat(),loc.lng()];coordsCache.set(address,point);return point}
async function getPoints(items){const result=[];for(const item of items)result.push(await geocode(item.address));return result}
function draw(items,positions,geometry){if(!map)return;clearMap();bounds=new google.maps.LatLngBounds();positions.forEach((p,i)=>{const loc={lat:p[0],lng:p[1]},marker=new google.maps.Marker({position:loc,map,label:i===0?'S':String(i),title:i===0?'Salida':items[i-1]?.client||'Parada'});const content='<b>'+esc(i===0?'Salida':items[i-1]?.client||'Parada')+'</b><br>'+esc(i===0?$('origin').value:items[i-1]?.address);const info=new google.maps.InfoWindow({content});marker.addListener('click',()=>info.open({anchor:marker,map}));markers.push(marker);bounds.extend(loc)});let path;if(geometry?.coordinates)path=geometry.coordinates.map(c=>({lat:c[1],lng:c[0]}));else path=positions.map(p=>({lat:p[0],lng:p[1]}));if(path.length>1){line=new google.maps.Polyline({path,strokeColor:'#ff781c',strokeWeight:5,strokeOpacity:0.95,map});path.forEach(p=>bounds.extend(p))}fitMap()}
function pendingOrders(){const d=$('routeDriver').value;return state.orders.filter(o=>['pendiente','en camino'].includes(o.status)&&(!d||o.driver===d))}function kmHaversine(a,b){const rad=x=>x*Math.PI/180,dlat=rad(b[0]-a[0]),dlon=rad(b[1]-a[1]);return 6371*2*Math.asin(Math.sqrt(Math.sin(dlat/2)**2+Math.cos(rad(a[0]))*Math.cos(rad(b[0]))*Math.sin(dlon/2)**2))}function pathDistance(path,matrix){return path.reduce((sum,v,i)=>sum+(i?matrix[path[i-1]][v]:matrix[0][v]),0)}function bestOrder(matrix,orders){let remaining=orders.map((_,i)=>i+1),route=[],last=0;while(remaining.length){remaining.sort((a,b)=>{const oa=orders[a-1],ob=orders[b-1];const pa=oa.priority==='alta'?1:0,pb=ob.priority==='alta'?1:0;return pb-pa||matrix[last][a]-matrix[last][b]||(oa.deadline||'99:99').localeCompare(ob.deadline||'99:99')});let n=remaining.shift();route.push(n);last=n}let improved=true,loops=0;while(improved&&loops++<30){improved=false;for(let i=0;i<route.length-1;i++)for(let j=i+1;j<route.length;j++){const candidate=[...route.slice(0,i),...route.slice(i,j+1).reverse(),...route.slice(j+1)];const score=p=>pathDistance(p,matrix)+p.reduce((s,n,k)=>s+(orders[n-1].priority==='alta'?k*100000:0),0);if(score(candidate)+1<score(route)){route=candidate;improved=true}}}return route}
async function fetchMatrix(points){const coords=points.map(p=>p[1]+','+p[0]).join(';');const r=await fetch('https://router.project-osrm.org/table/v1/driving/'+coords+'?annotations=distance,duration');if(!r.ok)throw Error('Servicio de distancias viales no disponible');const data=await r.json();if(data.code!=='Ok'||!data.distances?.length||data.distances.some(row=>row.some(v=>v===null)))throw Error('Algunas ubicaciones no están conectadas por carretera');return data}async function fetchRoad(points){const coords=points.map(p=>p[1]+','+p[0]).join(';');const r=await fetch('https://router.project-osrm.org/route/v1/driving/'+coords+'?overview=full&geometries=geojson');if(!r.ok)throw Error('Ruta vial no disponible');const data=await r.json();if(data.code!=='Ok'||!data.routes?.length)throw Error('No se pudo generar el recorrido');return data.routes[0]}
async function showPins(){if(busy)return;if(!await initMap())return;const orders=pendingOrders();if(!orders.length)return toast('No hay pedidos pendientes');busy=true;$('mapStatus').textContent='Buscando direcciones…';try{const origin=$('origin').value.trim(),items=origin?[{address:origin},...orders]:orders;const points=await getPoints(items);clearMap();points.forEach((p,i)=>markers.push(new google.maps.Marker({position:{lat:p[0],lng:p[1]},map,title:items[i].address})));bounds=new google.maps.LatLngBounds();points.forEach(p=>bounds.extend({lat:p[0],lng:p[1]}));fitMap();$('mapStatus').textContent='Ubicaciones encontradas. Los marcadores no implican un orden optimizado.'}catch(e){toast(e.message);$('mapStatus').textContent=e.message}finally{busy=false}}
async function optimizeRoute(){if(busy)return;if(!await initMap())return;const origin=$('origin').value.trim();if(!origin)return toast('Escribe un punto de salida completo');const orders=pendingOrders();if(!orders.length)return toast('No hay pedidos pendientes');if(orders.length>10)return toast('El prototipo admite hasta 10 paradas por ruta');busy=true;$('mapStatus').textContent='Consultando ubicaciones y distancias por carretera…';try{const pts=await getPoints([{address:origin},...orders]);const table=await fetchMatrix(pts);const order=bestOrder(table.distances,orders);const sorted=order.map(i=>orders[i-1]);const sortedPts=[pts[0],...order.map(i=>pts[i])];const road=await fetchRoad(sortedPts);state.lastRoute={ids:sorted.map(o=>o.id),origin,driver:$('routeDriver').value,km:road.distance/1000,minutes:road.duration/60,at:new Date().toISOString(),positions:sortedPts};draw(sorted,sortedPts,road.geometry);$('mapStatus').textContent='Ruta calculada por carreteras: '+(road.distance/1000).toFixed(1)+' km · '+Math.round(road.duration/60)+' min aproximados. Sin tráfico en vivo.';notify('Ruta optimizada con '+sorted.length+' paradas');persist();toast('Ruta calculada correctamente')}catch(e){$('mapStatus').textContent='No fue posible optimizar: '+explainMapError(e)+'. Puedes abrir los pedidos en Google Maps con el botón sin API.';toast(explainMapError(e))}finally{busy=false}}
function renderRoute(){const r=state.lastRoute;if(!r){$('routeList').className='empty';$('routeList').textContent='Aún no hay ruta calculada.';return}const entries=r.ids.map(id=>state.orders.find(o=>o.id===id)).filter(Boolean);$('routeList').className='';$('routeList').innerHTML=entries.map((o,i)=>`<div class="route-step"><b>Parada ${i+1}: ${esc(o.client)}</b><div class="muted">${esc(o.address)} · ${esc(o.status)}${o.deadline?' · Antes de '+esc(o.deadline):''}</div></div>`).join('')||'Sin pedidos activos'}function openOrdersInGoogleMaps(){const orders=pendingOrders();if(!orders.length)return toast('Agrega pedidos pendientes para verlos en Google Maps');const origin=$('origin').value.trim();const stops=orders.slice(0,10).map(o=>o.address);const destination=stops.pop();const params=new URLSearchParams({api:'1',destination,travelmode:'driving'});if(origin)params.set('origin',origin);if(stops.length)params.set('waypoints',stops.join('|'));window.open('https://www.google.com/maps/dir/?'+params.toString(),'_blank','noopener,noreferrer');}function openMaps(){const r=state.lastRoute;if(!r)return toast('Primero optimiza una ruta');const entries=r.ids.map(id=>state.orders.find(o=>o.id===id)).filter(Boolean);if(!entries.length)return;const parts=['https://www.google.com/maps/dir/?api=1','origin='+encodeURIComponent(r.origin),'destination='+encodeURIComponent(entries.at(-1).address),'travelmode=driving'];if(entries.length>1)parts.push('waypoints='+encodeURIComponent(entries.slice(0,-1).map(x=>x.address).join('|')));window.open(parts.join('&'),'_blank','noopener,noreferrer')}function finishRoute(){const r=state.lastRoute;if(!r)return toast('No hay ruta para guardar');state.history.unshift({id:uid(),at:new Date().toLocaleString('es-MX'),driver:state.drivers.find(d=>d.id===r.driver)?.name||'Todos',origin:r.origin,stops:r.ids.length,km:r.km,minutes:r.minutes});notify('Recorrido guardado en historial');persist();toast('Recorrido guardado')}
function stats(){const r=state.lastRoute,km=r?.km;const eff=Number($('efficiency').value),price=Number($('fuelPrice').value);$('statKm').textContent=Number.isFinite(km)?km.toFixed(1):'—';$('statTime').textContent=Number.isFinite(r?.minutes)?Math.round(r.minutes):'—';const valid=Number.isFinite(km)&&eff>0&&price>=0;$('statFuel').textContent=valid?(km/eff).toFixed(2):'—';$('statCost').textContent=valid?'$'+(km/eff*price).toFixed(2):'—';$('comparison').textContent=valid?'Estimación: '+km.toFixed(1)+' km ÷ '+eff+' km/L × $'+price+'/L. No equivale a ahorro comprobado.':'Optimiza una ruta e ingresa valores válidos para estimar combustible.'}
function demo(){if(state.orders.length&&!confirm('¿Agregar pedidos de demostración a los actuales?'))return;const examples=[['Ana García','Av. Guerrero 1200, Nuevo Laredo, Tamaulipas','normal'],['Luis Pérez','Av. Reforma 3000, Nuevo Laredo, Tamaulipas','alta'],['Sofía Ruiz','Calle Perú 1800, Nuevo Laredo, Tamaulipas','normal']];examples.forEach(([client,address,priority])=>state.orders.push({id:uid(),client,address,priority,phone:'',description:'Pedido de ejemplo',deadline:'',driver:'',status:'pendiente',proof:''}));$('origin').value='Plaza Hidalgo, Nuevo Laredo, Tamaulipas';notify('Se cargaron pedidos de demostración');state.lastRoute=null;persist();toast('Ejemplo listo; abre Mapa y rutas')};function initializeVayaMapSettings(){try{$('googleKey').value=getMapKey();$('mapStyle').value=localStorage.getItem(MAP_STYLE_STORAGE)||'roadmap';setMapStatus(getMapKey()?'Clave guardada: abre Mapa y rutas para cargar Google Maps.':'Para activar Google Maps, introduce tu clave API.')}catch(e){setMapStatus('No se pudo leer la configuración del mapa: '+e.message)}}

const VAYA_SUPABASE_URL='https://abyeigidewzrvfmzwahs.supabase.co';
const VAYA_SUPABASE_PUBLIC_KEY='sb_publishable_r0TOYNLvdjCOQAUR_EOrMA_VzrK33Qy';
const VAYA_STRIPE_PRICE_IDS={basic:'price_1Ub86RLpJ49ObUNPB4tlDUvv',premium:'price_1Ub891LpJ49ObUNPc5aVjdZ7'};
let vayaAuth=null;
function vayaAuthMessage(msg){$('authMessage').textContent=msg}
function updateVayaAccount(session){const user=session?.user; $('accountStatus').textContent=user?'Cuenta: '+(user.email||'Conectada'):'Sin iniciar sesión';$('logoutButton').classList.toggle('auth-hidden',!user);$('authPanel').classList.toggle('auth-hidden',!!user)}
async function vayaLogout(){if(!vayaAuth)return;const {error}=await vayaAuth.auth.signOut();if(error)toast('No se pudo cerrar sesión: '+error.message);else{updateVayaAccount(null);toast('Sesión cerrada')}}
function selectVayaPlan(plan){const name=plan==='basic'?'VaYa Básica':'VaYa Premium';document.querySelectorAll('.plan-card').forEach(x=>x.classList.remove('selected'));$('plan-'+plan).classList.add('selected');$('planMessage').textContent='Seleccionaste '+name+'. El pago aún no está habilitado; no se realizó ningún cargo.';toast('Plan seleccionado (demostración)')}
async function initializeVayaAuth(){if(!window.supabase?.createClient){vayaAuthMessage('No se pudo cargar Supabase. Comprueba tu conexión a internet.');return}try{vayaAuth=window.supabase.createClient(VAYA_SUPABASE_URL,VAYA_SUPABASE_PUBLIC_KEY);const {data,error}=await vayaAuth.auth.getSession();if(error)throw error;updateVayaAccount(data.session);vayaAuth.auth.onAuthStateChange((_event,session)=>updateVayaAccount(session))}catch(e){vayaAuthMessage('Error al conectar con Supabase: '+e.message)}}
$('signupForm').addEventListener('submit',async e=>{e.preventDefault();if(!vayaAuth)return vayaAuthMessage('Supabase no está disponible.');const button=e.target.querySelector('button');button.disabled=true;vayaAuthMessage('Creando cuenta…');try{const {data,error}=await vayaAuth.auth.signUp({email:$('signupEmail').value.trim(),password:$('signupPassword').value,emailRedirectTo:'https://ximetlz.github.io/VaYa./'});if(error)throw error;vayaAuthMessage(data.session?'Cuenta creada y sesión iniciada.':'Revisa tu correo y confirma tu cuenta antes de iniciar sesión.');$('signupPassword').value=''}catch(err){vayaAuthMessage('No se pudo registrar: '+err.message)}finally{button.disabled=false}});
$('loginForm').addEventListener('submit',async e=>{e.preventDefault();if(!vayaAuth)return vayaAuthMessage('Supabase no está disponible.');const button=e.target.querySelector('button');button.disabled=true;vayaAuthMessage('Iniciando sesión…');try{const {error}=await vayaAuth.auth.signInWithPassword({email:$('loginEmail').value.trim(),password:$('loginPassword').value});if(error)throw error;vayaAuthMessage('Sesión iniciada.');$('loginPassword').value=''}catch(err){vayaAuthMessage('No se pudo iniciar sesión: '+err.message)}finally{button.disabled=false}});
initializeVayaAuth();

/* VaYa 2026: mejoras locales para repartidores independientes. */
const vMoney=n=>Number(n||0).toLocaleString('es-MX',{style:'currency',currency:'MXN'});
const vDate=x=>x?new Date(x).toLocaleString('es-MX',{dateStyle:'medium',timeStyle:'short'}):'Sin hora';
const vDay=x=>new Date(x).toLocaleDateString('es-MX',{year:'numeric',month:'long',day:'numeric'});
const vNow=()=>new Date().toISOString();
const vLocalDate=()=>{const d=new Date();return [d.getFullYear(),String(d.getMonth()+1).padStart(2,'0'),String(d.getDate()).padStart(2,'0')].join('-')};
const vLocalDateTime=()=>{const d=new Date();return vLocalDate()+'T'+String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0')};
state.shifts=Array.isArray(state.shifts)?state.shifts:[];state.expenses=Array.isArray(state.expenses)?state.expenses:[];state.recurring=Array.isArray(state.recurring)?state.recurring:[];
let vVerifiedPlan='free';let vModalResolve=null;
function askVaya(title,body,accept='Confirmar') {return new Promise(resolve=>{const m=$('vayaModal');$('modalTitle').textContent=title;$('modalText').textContent=body;$('modalAccept').textContent=accept;m.hidden=false;vModalResolve=resolve;$('modalAccept').focus()})}
function closeVaya(result){$('vayaModal').hidden=true;if(vModalResolve){const f=vModalResolve;vModalResolve=null;f(result)}}
$('modalAccept').onclick=()=>closeVaya(true);$('modalCancel').onclick=()=>closeVaya(false);
$('vayaModal').addEventListener('click',e=>{if(e.target===$('vayaModal'))closeVaya(false)});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('vayaModal').hidden)closeVaya(false)});
function vCurrentShift(){return state.shifts.find(s=>!s.endedAt)}
function vCompleted(s){return state.orders.filter(o=>o.status==='entregado'&&o.shiftId===s.id)}
function vPlan(){return vVerifiedPlan}
function vCanPremium(){return vPlan()==='premium'}
function vRequirePremium(){if(vCanPremium())return true;toast('Esta función necesita Premium activo y verificado.');go('planes');return false}
function vTodayCount(){return state.orders.filter(o=>o.createdAt?.slice(0,10)===vLocalDate()).length}
function vIsLate(o){if(!o.deadline||!o.deliveredAt)return null;return new Date(o.deliveredAt)>new Date(o.deadline)}
function vDeadline(o){return o.deadline?new Date(o.deadline).getTime():null}
function vStatusClass(o){if(o.status==='entregado')return 'ok';if(o.deadline&&o.status!=='no entregado'){const delta=vDeadline(o)-Date.now();return delta<0?'danger':delta<45*60000?'warn':''}return ''}
function vDeadlineLabel(o){if(!o.deadline)return '';if(o.status==='entregado')return vIsLate(o)?'Entregado con retraso':'Entregado a tiempo';if(o.status==='no entregado')return '';const d=vDeadline(o)-Date.now();return d<0?'Hora límite vencida':d<45*60000?'Próximo a vencer':'Con tiempo'}
// El formulario original usa un listener; lo interceptamos para registrar campos de jornada y cobro.
$('orderForm').addEventListener('submit',e=>{e.preventDefault();e.stopImmediatePropagation();if(vPlan()==='free'&&vTodayCount()>=10)return toast('El plan Gratis admite hasta 10 pedidos por día.');const client=$('client').value.trim(),address=$('address').value.trim();if(!client||!address)return;const shift=vCurrentShift();const x={id:uid(),client,address,phone:$('phone').value.replace(/\D/g,''),description:$('description').value.trim(),priority:$('priority').value,deadline:$('deadline').value?new Date($('deadline').value).toISOString():'',driver:'',status:'pendiente',proof:'',fee:Math.max(0,Number($('orderFee').value)||0),createdAt:vNow(),shiftId:shift?.id||null};state.orders.push(x);state.lastRoute=null;notify('Pedido registrado: '+client);persist();e.target.reset();toast('Pedido registrado')},true);
async function deleteOrder(id){const o=state.orders.find(x=>x.id===id);if(!o)return;if(!await askVaya('Eliminar pedido','¿Eliminar el pedido de '+o.client+'? Esta acción no se puede deshacer.','Eliminar'))return;state.orders=state.orders.filter(x=>x.id!==id);state.lastRoute=null;notify('Pedido eliminado');persist()}
async function deleteDriver(id){if(!await askVaya('Eliminar perfil','¿Eliminar este perfil?','Eliminar'))return;state.drivers=state.drivers.filter(x=>x.id!==id);persist()}
function vMarkDelivered(o){let shift=vCurrentShift();if(!shift){shift={id:uid(),startedAt:vNow(),endedAt:null,km:0};state.shifts.push(shift)}o.status='entregado';o.deliveredAt=vNow();o.recordedAt=o.deliveredAt;o.shiftId=shift.id;o.proof='Entrega confirmada';state.lastRoute=null;notify('Entrega completada: '+o.client);persist();toast('Entrega registrada a las '+vDate(o.deliveredAt))}
function changeStatus(id){const o=state.orders.find(x=>x.id===id);if(!o)return;const menu=document.createElement('div');menu.className='modal-overlay';menu.innerHTML='<div class="modal-dialog" role="dialog" aria-modal="true"><h2>Cambiar estado</h2><p>Pedido: '+esc(o.client)+'</p><div class="actions"><button class="btn alt" data-s="pendiente">Pendiente</button><button class="btn alt" data-s="en camino">En camino</button><button class="btn" data-s="entregado">Entregado</button><button class="btn outline" data-s="no entregado">No entregado</button><button class="btn alt" data-s="cancelar">Cancelar</button></div></div>';document.body.append(menu);menu.addEventListener('click',e=>{const b=e.target.closest('[data-s]');if(!b){if(e.target===menu)menu.remove();return}const val=b.dataset.s;menu.remove();if(val==='cancelar')return;if(val==='entregado'){vMarkDelivered(o);return}o.status=val;if(val!=='entregado'){o.deliveredAt=null;o.recordedAt=null;o.shiftId=null}state.lastRoute=null;notify('Estado actualizado: '+o.client+' → '+val);persist()})}
async function editDelivery(id){const o=state.orders.find(x=>x.id===id&&x.status==='entregado');if(!o)return;const previous=o.deliveredAt;const next=promptTime(o.deliveredAt);if(!next)return;const d=new Date(next);if(!Number.isFinite(d.getTime())||d.getTime()>Date.now())return toast('Elige una fecha y hora válida, no futura.');if(!await askVaya('Corregir hora','Se conservará la hora registrada originalmente y se guardará la corrección.','Guardar'))return;o.deliveryCorrections=Array.isArray(o.deliveryCorrections)?o.deliveryCorrections:[];o.deliveryCorrections.push({previous,correctedAt:vNow(),next:d.toISOString()});o.deliveredAt=d.toISOString();persist();toast('Hora corregida')}
function promptTime(iso){const layer=document.createElement('div');layer.className='modal-overlay';layer.innerHTML='<div class="modal-dialog"><h2>Corregir fecha y hora</h2><p>Se conservará el registro de la corrección.</p><input id="vEditTime" type="datetime-local"><div class="actions"><button class="btn alt" id="vCancelTime">Cancelar</button><button class="btn" id="vSaveTime">Continuar</button></div></div>';const d=new Date(iso);const fmt=n=>String(n).padStart(2,'0');layer.querySelector('input').value=[d.getFullYear(),fmt(d.getMonth()+1),fmt(d.getDate())].join('-')+'T'+fmt(d.getHours())+':'+fmt(d.getMinutes());document.body.append(layer);return new Promise(resolve=>{layer.querySelector('#vCancelTime').onclick=()=>{layer.remove();resolve(null)};layer.querySelector('#vSaveTime').onclick=()=>{const x=layer.querySelector('input').value;layer.remove();resolve(x)}})}
// Reemplazar edición para esperar el diálogo sin bloquear la interfaz.
editDelivery=async function(id){const o=state.orders.find(x=>x.id===id&&x.status==='entregado');if(!o)return;const next=await promptTime(o.deliveredAt);if(!next)return;const d=new Date(next);if(!Number.isFinite(d.getTime())||d.getTime()>Date.now())return toast('Elige una fecha y hora válida, no futura.');if(!await askVaya('Confirmar corrección','Se guardará la hora original y la nueva hora para este pedido.','Guardar'))return;o.deliveryCorrections=Array.isArray(o.deliveryCorrections)?o.deliveryCorrections:[];o.deliveryCorrections.push({previous:o.deliveredAt,correctedAt:vNow(),next:d.toISOString()});o.deliveredAt=d.toISOString();persist();toast('Hora corregida')};
function startShift(){if(vCurrentShift())return toast('Ya tienes una jornada activa');state.shifts.push({id:uid(),startedAt:vNow(),endedAt:null,km:0});notify('Jornada iniciada');persist();toast('Jornada iniciada')}
async function endShift(){const s=vCurrentShift();if(!s)return toast('No hay jornada activa');if(!await askVaya('Finalizar jornada','Se guardarán las entregas completadas. Los pedidos pendientes seguirán disponibles.','Finalizar'))return;s.endedAt=vNow();notify('Jornada finalizada');persist();toast('Jornada guardada en historial')}
function finishRoute(){const r=state.lastRoute;if(!r)return toast('Primero calcula una ruta');const s=vCurrentShift();if(!s)return toast('Inicia tu jornada antes de guardar distancias');s.km=(Number(s.km)||0)+(Number(r.km)||0);notify('Distancia estimada registrada en jornada');persist();toast('Distancia estimada guardada')}
function vRenderHistory(){const shifts=[...state.shifts].sort((a,b)=>new Date(b.startedAt)-new Date(a.startedAt));$('historyList').innerHTML=shifts.length?shifts.map(s=>{const delivered=vCompleted(s),income=delivered.reduce((a,o)=>a+Number(o.fee||0),0);return `<details class="history-card"><summary>${esc(vDay(s.startedAt))} · ${delivered.length} entregas · ${esc(vMoney(income))}</summary><small>${esc(vDate(s.startedAt))} — ${s.endedAt?esc(vDate(s.endedAt)):'Jornada en curso'} · ${Number(s.km||0).toFixed(1)} km estimados</small>${delivered.length?delivered.map(o=>`<div class="item"><b>${esc(o.client)}</b><small>📍 ${esc(o.address)}</small><small>🕘 Entregado: ${esc(vDate(o.deliveredAt))}</small><small>⏰ Límite: ${o.deadline?esc(vDate(o.deadline)):'Sin límite'} · ${vIsLate(o)===null?'Sin evaluación':vIsLate(o)?'Con retraso':'A tiempo'}</small><small>💰 ${esc(vMoney(o.fee))}</small>${o.deliveryCorrections?.length?'<small>Hora corregida '+o.deliveryCorrections.length+' vez/veces (registro original conservado)</small>':''}<div class="actions"><button class="btn alt tiny-action" onclick="editDelivery('${esc(o.id)}')">Corregir hora</button></div></div>`).join(''):'<p>Esta jornada aún no tiene entregas completadas.</p>'}</details>`}).join(''):'<div class="empty">Aún no hay jornadas. Inicia una desde Mi jornada.</div>'}
function vRenderOrders(){const filtered=state.orders.filter(x=>$('filter').value==='todos'||x.status===$('filter').value);$('orders').innerHTML=filtered.length?filtered.map(x=>`<div class="item"><div class="itemtop"><div><b>${esc(x.client)}</b><small>📍 ${esc(x.address)}</small><small>${esc(x.description||'Sin descripción')}</small><small>💰 ${esc(vMoney(x.fee))} · ${esc(x.priority||'normal')}</small><span class="status ${vStatusClass(x)}">${esc(x.status)}${x.deadline?' · '+esc(vDate(x.deadline)):''}</span> ${vDeadlineLabel(x)?`<span class="status ${vStatusClass(x)}">${esc(vDeadlineLabel(x))}</span>`:''}</div><div class="actions"><button class="btn alt" onclick="changeStatus('${esc(x.id)}')">Estado</button><button class="btn alt" onclick="editOrder('${esc(x.id)}')">Editar</button><button class="btn outline" onclick="deleteOrder('${esc(x.id)}')">Eliminar</button></div></div>${x.phone?`<div class="actions"><button class="btn alt" onclick="whatsapp('${esc(x.id)}')">WhatsApp ↗</button></div>`:''}</div>`).join(''):'<div class="empty">No hay pedidos para mostrar.</div>'}
function editOrder(id){const o=state.orders.find(x=>x.id===id);if(!o)return;const modal=document.createElement('div');modal.className='modal-overlay';modal.innerHTML=`<div class="modal-dialog"><h2>Editar pedido</h2><div class="field"><label>Nombre</label><input id="edClient" maxlength="80" value="${esc(o.client)}"></div><div class="field"><label>Dirección</label><input id="edAddress" maxlength="250" value="${esc(o.address)}"></div><div class="field"><label>Fecha y hora límite</label><input id="edDeadline" type="datetime-local"></div><div class="field"><label>Prioridad</label><select id="edPriority"><option value="normal">Normal</option><option value="alta">Alta</option><option value="urgente">Urgente</option></select></div><div class="field"><label>Pago (MXN)</label><input id="edFee" type="number" min="0" step="0.01" value="${Number(o.fee)||0}"></div><div class="actions"><button class="btn alt" id="edCancel">Cancelar</button><button class="btn" id="edSave">Guardar cambios</button></div></div>`;document.body.append(modal);const t=modal.querySelector('#edDeadline');if(o.deadline){const d=new Date(o.deadline),z=n=>String(n).padStart(2,'0');t.value=d.getFullYear()+'-'+z(d.getMonth()+1)+'-'+z(d.getDate())+'T'+z(d.getHours())+':'+z(d.getMinutes())}modal.querySelector('#edPriority').value=o.priority||'normal';modal.querySelector('#edCancel').onclick=()=>modal.remove();modal.querySelector('#edSave').onclick=()=>{const client=modal.querySelector('#edClient').value.trim(),address=modal.querySelector('#edAddress').value.trim();if(!client||!address)return toast('Nombre y dirección obligatorios');Object.assign(o,{client,address,priority:modal.querySelector('#edPriority').value,deadline:t.value?new Date(t.value).toISOString():'',fee:Math.max(0,Number(modal.querySelector('#edFee').value)||0)});state.lastRoute=null;modal.remove();persist();toast('Pedido actualizado')}}
function vRenderShifts(){const s=vCurrentShift(),orders=s?vCompleted(s):[],income=orders.reduce((a,o)=>a+Number(o.fee||0),0);$('shiftStatus').innerHTML=s?`<span class="status ok">Jornada activa</span><p>Iniciada: ${esc(vDate(s.startedAt))}</p>`:'<span class="status">Sin jornada activa</span><p>Presiona «Iniciar jornada» cuando comiences a trabajar.</p>';$('shiftSummary').innerHTML=`<div class="grid" style="grid-template-columns:repeat(2,minmax(0,1fr))"><div class="metric"><span class="muted">Entregados</span><strong>${orders.length}</strong></div><div class="metric"><span class="muted">Pendientes</span><strong>${state.orders.filter(o=>o.status==='pendiente'||o.status==='en camino').length}</strong></div><div class="metric"><span class="muted">Ingresos</span><strong>${esc(vMoney(income))}</strong></div><div class="metric"><span class="muted">Distancia estimada</span><strong>${Number(s?.km||0).toFixed(1)} km</strong></div></div>`}
function vRenderPerformance(){const done=state.orders.filter(o=>o.status==='entregado'&&o.deliveredAt),evaluated=done.filter(o=>o.deadline),onTime=evaluated.filter(o=>!vIsLate(o));$('statDeliveries').textContent=done.length;$('statOnTime').textContent=evaluated.length?Math.round(onTime.length/evaluated.length*100)+'%':'—';$('statIncome').textContent=vMoney(done.reduce((a,o)=>a+Number(o.fee||0),0));$('statKm').textContent=state.lastRoute?.km?.toFixed(1)||'—';const recent=[...state.shifts].reverse().slice(0,7);$('performanceDetails').innerHTML=`<p>${done.length} entregas completadas · ${onTime.length} a tiempo de ${evaluated.length} con hora límite.</p><h3>Últimas jornadas</h3>${recent.length?recent.map(s=>`<div class="item row-line"><span>${esc(vDay(s.startedAt))}</span><b>${vCompleted(s).length} entregas</b></div>`).join(''):'<div class="empty">Sin jornadas registradas.</div>'}`}
function vRenderEarnings(){const done=state.orders.filter(o=>o.status==='entregado'),income=done.reduce((a,o)=>a+Number(o.fee||0),0),expenses=state.expenses.reduce((a,x)=>a+Number(x.amount||0),0);$('earnTotal').textContent=vMoney(income);$('expenseTotal').textContent=vMoney(expenses);$('netTotal').textContent=vMoney(income-expenses);$('expenseForm').querySelector('button').disabled=!vCanPremium();$('earningsList').innerHTML=`<h3>Ingresos de entregas</h3>${done.slice(-10).reverse().map(o=>`<div class="item row-line"><span>${esc(o.client)} <small>${esc(vDate(o.deliveredAt))}</small></span><b>${esc(vMoney(o.fee))}</b></div>`).join('')||'<p>Sin entregas registradas.</p>'}<h3>Gastos (Premium)</h3>${state.expenses.map(x=>`<div class="item row-line"><span>${esc(x.name)}<small>${esc(vDate(x.at))}</small></span><b>${esc(vMoney(x.amount))}</b></div>`).join('')||'<p>No hay gastos registrados.</p>'}`}
$('expenseForm').addEventListener('submit',e=>{e.preventDefault();if(!vRequirePremium())return;const name=$('expenseName').value.trim(),amount=Number($('expenseAmount').value);if(!name||!Number.isFinite(amount)||amount<=0)return toast('Completa los datos');state.expenses.unshift({id:uid(),name,amount,at:vNow(),shiftId:vCurrentShift()?.id||null});persist();e.target.reset()});
function vRenderPremium(){const locked=!vCanPremium();$('premiumAccess').innerHTML=locked?'<div class="premium-locked">🔒 Premium no verificado. Las herramientas exclusivas se activarán cuando exista una suscripción válida en el servidor. El mapa y las funciones gratuitas siguen disponibles.</div>':'<span class="status ok">Premium verificado</span>';$('repeatForm').querySelector('button').disabled=locked;$('premium').querySelector('button[onclick="parseQuickOrder()"]').disabled=locked;$('repeatList').innerHTML=state.recurring.map(r=>`<div class="item row-line"><span>${esc(r.client)} · ${esc(r.address)} · día ${r.day}</span><button class="btn outline tiny-action" onclick="deleteRecurring('${esc(r.id)}')">Eliminar</button></div>`).join('');const zones=new Map();state.orders.filter(o=>o.status==='entregado').forEach(o=>{const parts=o.address.split(',').map(x=>x.trim());const zone=parts.length>=2?parts[1]:'Sin zona identificada';zones.set(zone,(zones.get(zone)||0)+1)});$('zoneAnalysis').innerHTML=locked?'<p>Disponible con Premium.</p>':([...zones.entries()].sort((a,b)=>b[1]-a[1]).slice(0,8).map(([z,n])=>`<div class="item row-line"><span>${esc(z)}</span><b>${n} entregas</b></div>`).join('')||'<p>Completa entregas para generar el análisis.</p>')+'<p class="notice">Zonas aproximadas a partir del texto de las direcciones, no un mapa de calor geográfico.</p>'}
function parseQuickOrder(){if(!vRequirePremium())return;const raw=$('quickText').value.trim();if(!raw)return toast('Pega un mensaje');const lines=raw.split('\n').map(x=>x.trim()).filter(Boolean);const address=lines.find(x=>/direcci[oó]n|calle|avenida|av\.|colonia/i.test(x))||lines[1]||'';const name=(lines.find(x=>/nombre|cliente/i.test(x))||lines[0]||'').replace(/^(nombre|cliente)\s*:\s*/i,'');$('client').value=name.slice(0,80);$('address').value=address.replace(/^direcci[oó]n\s*:\s*/i,'').slice(0,250);$('description').value='Revisar datos extraídos del mensaje';$('quickPreview').textContent='Pedido preparado. Verifica nombre, dirección, prioridad y hora límite antes de guardarlo.';go('pedidos')}
$('repeatForm').addEventListener('submit',e=>{e.preventDefault();if(!vRequirePremium())return;state.recurring.push({id:uid(),client:$('repeatClient').value.trim(),address:$('repeatAddress').value.trim(),day:Number($('repeatDay').value),time:$('repeatTime').value,lastCreated:''});persist();e.target.reset();toast('Entrega recurrente programada')});
async function deleteRecurring(id){if(!vRequirePremium())return;if(!await askVaya('Eliminar recurrencia','¿Dejar de crear esta entrega recurrente?','Eliminar'))return;state.recurring=state.recurring.filter(x=>x.id!==id);persist()}
function vProcessRecurring(){if(!vCanPremium())return;const today=vLocalDate(),day=new Date().getDay();let changed=false;for(const r of state.recurring){if(r.day!==day||r.lastCreated===today)continue;state.orders.push({id:uid(),client:r.client,address:r.address,phone:'',description:'Pedido recurrente',priority:'normal',deadline:r.time?new Date(today+'T'+r.time).toISOString():'',driver:'',status:'pendiente',proof:'',fee:0,createdAt:vNow(),shiftId:vCurrentShift()?.id||null});r.lastCreated=today;changed=true}if(changed)persist()}
function selectVayaPlan(plan){document.querySelectorAll('.plan-card').forEach(x=>x.classList.remove('selected'));$('plan-'+plan)?.classList.add('selected');$('planMessage').textContent=plan==='free'?'El plan Gratis es el predeterminado.':`VaYa ${plan==='basic'?'Básica':'Premium'}: ${plan==='basic'?'$80':'$180'} MXN/mes. Esta pantalla no cobra ni activa funciones; falta conectar el checkout y verificar la suscripción.`;go('planes')}
function vRenderPlan(){$('planDetails').innerHTML=`<div class="item"><b>Acceso confirmado: ${vPlan()==='premium'?'Premium':vPlan()==='basic'?'Básica':'Gratis'}</b><small>Las compras no se activan desde el navegador. No compartas información sensible mientras los pedidos sigan guardándose solo en este dispositivo.</small></div><p><b>Gratis:</b> hasta 10 pedidos nuevos por día, mapa, organización manual, jornada, historial e ingresos.</p><p><b>Básica ($80/mes):</b> pedidos sin límite comercial, estadísticas por jornadas y mayor capacidad.</p><p><b>Premium ($180/mes):</b> rutas inteligentes por urgencia y hora límite, planificación, alertas, ganancias y gastos, recurrencias, registro rápido y zonas.</p>`}
// Render original + nuevas vistas, sustituyendo el contenido legado.
render=function(){const o=state.orders;$('mTotal').textContent=o.length;$('mDone').textContent=o.filter(x=>x.status==='entregado').length;$('mPending').textContent=o.filter(x=>x.status==='pendiente').length;$('mTransit').textContent=o.filter(x=>x.status==='en camino').length;vRenderOrders();vRenderShifts();vRenderHistory();vRenderPerformance();vRenderEarnings();vRenderPremium();vRenderPlan();renderRoute();$('noticeList').innerHTML=state.notices.length?state.notices.map(n=>`<div class="item"><small>${esc(n.at)}</small>${esc(n.msg)}</div>`).join(''):'<div class="empty">Sin notificaciones.</div>'};
// El orden de rutas combina ETA y fechas límite; OSRM no aporta tráfico en vivo.
function vRankRoute(table,orders){const remain=orders.map((_,i)=>i+1),seq=[];let current=0,elapsed=0;const now=Date.now();while(remain.length){let best=remain[0],bestScore=Infinity;for(const idx of remain){const o=orders[idx-1],travel=table.durations[current][idx]||0,arrival=now+(elapsed+travel)*1000;const deadline=o.deadline?new Date(o.deadline).getTime():null;const slack=deadline===null?Infinity:(deadline-arrival)/60000;const priority=o.priority==='urgente'?2:o.priority==='alta'?1:0;const latePenalty=deadline!==null&&slack<0?30000+Math.abs(slack)*30:0;const urgency=deadline===null?0:Math.max(0,180-slack)*40;const score=travel/60-priority*55-urgency-latePenalty;if(score<bestScore){bestScore=score;best=idx}}elapsed+=(table.durations[current][best]||0)+180;seq.push(best);remain.splice(remain.indexOf(best),1);current=best}return seq}
optimizeRoute=async function(){if(busy)return;if(!await initMap())return;const origin=$('origin').value.trim();if(!origin)return toast('Indica un punto de salida');const orders=pendingOrders();if(!orders.length)return toast('No hay pedidos pendientes');if(orders.length>10)return toast('Por ahora se admiten hasta 10 paradas por ruta');if(!vCanPremium()){const used=localStorage.getItem('vaya-free-route-day');if(used===vLocalDate())return toast('La prueba gratuita de optimización ya se utilizó hoy.');if(orders.length>3)return toast('La prueba gratuita admite hasta 3 entregas.')}busy=true;$('mapStatus').textContent='Calculando distancias y prioridades…';try{const pts=await getPoints([{address:origin},...orders]),table=await fetchMatrix(pts);const sequence=vRankRoute(table,orders),sorted=sequence.map(i=>orders[i-1]),sortedPts=[pts[0],...sequence.map(i=>pts[i])],road=await fetchRoad(sortedPts);state.lastRoute={ids:sorted.map(o=>o.id),origin,driver:'',km:road.distance/1000,minutes:road.duration/60,at:vNow(),positions:sortedPts};draw(sorted,sortedPts,road.geometry);$('mapStatus').textContent=`Ruta sugerida: ${(road.distance/1000).toFixed(1)} km · ${Math.round(road.duration/60)} min de conducción aproximados. Se consideran prioridades y horas límite; sin tráfico en vivo.`;if(!vCanPremium())localStorage.setItem('vaya-free-route-day',vLocalDate());notify('Ruta recomendada con '+sorted.length+' paradas');persist();toast('Ruta recomendada calculada')}catch(e){$('mapStatus').textContent='No se pudo calcular: '+explainMapError(e);toast(explainMapError(e))}finally{busy=false}};
// Corregir el estado de mapa y ruta al navegar: no afirmar que está calculada si no hay resultados.
const vOldGo=go;go=function(id){vOldGo(id);if(id==='rutas'&&state.lastRoute)renderRoute()};
// Migración: entregas antiguas sin hora se mantienen, pero no se inventan datos.
state.orders.forEach(o=>{if(o.fee==null)o.fee=0;if(!o.createdAt)o.createdAt=null});
render();
// Demostración sin ventanas nativas del navegador.
demo=async function(){if(state.orders.length&&!await askVaya('Cargar demostración','¿Agregar tres pedidos ficticios a los actuales?','Agregar'))return;const examples=[['Ana García','Av. Guerrero 1200, Nuevo Laredo, Tamaulipas','normal'],['Luis Pérez','Av. Reforma 3000, Nuevo Laredo, Tamaulipas','alta'],['Sofía Ruiz','Calle Perú 1800, Nuevo Laredo, Tamaulipas','normal']];if(vPlan()==='free'&&vTodayCount()+examples.length>10)return toast('Se superaría el límite gratuito de 10 pedidos al día');for(const [client,address,priority] of examples)state.orders.push({id:uid(),client,address,priority,phone:'',description:'Pedido de ejemplo',deadline:'',driver:'',status:'pendiente',proof:'',fee:0,createdAt:vNow(),shiftId:vCurrentShift()?.id||null});$('origin').value='Plaza Hidalgo, Nuevo Laredo, Tamaulipas';state.lastRoute=null;notify('Se cargaron pedidos de demostración');persist();toast('Pedidos de ejemplo agregados')};
// Alertas visibles dentro de la app (sin notificaciones push).
const vBaseRender=render;
render=function(){vBaseRender();const risk=state.orders.filter(o=>['pendiente','en camino'].includes(o.status)&&o.deadline&&vDeadline(o)-Date.now()<45*60000).sort((a,b)=>vDeadline(a)-vDeadline(b));if(risk.length)$('noticeList').insertAdjacentHTML('afterbegin',risk.map(o=>`<div class="item"><span class="status ${vStatusClass(o)}">${vDeadline(o)<Date.now()?'Retrasado':'Próximo a vencer'}</span><b> ${esc(o.client)}</b><small>${esc(o.address)} · Límite ${esc(vDate(o.deadline))}</small></div>`).join(''))};
queueMicrotask(initializeVayaMapSettings);
</script><div class="modal-overlay" hidden="" id="vayaModal" role="presentation"><div aria-labelledby="modalTitle" aria-modal="true" class="modal-dialog" role="dialog"><h2 id="modalTitle">Confirmar acción</h2><p id="modalText"></p><div class="actions"><button class="btn alt" id="modalCancel">Cancelar</button><button class="btn" id="modalAccept">Confirmar</button></div></div></div></body></html>
